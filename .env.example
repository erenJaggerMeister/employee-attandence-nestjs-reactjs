# Database Configuration (PostgreSQL Native Windows)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=dexa_attendance_db

# Security & JWT
JWT_SECRET=dexa_attendance_super_secret_jwt_key_2026_dexa_group
JWT_EXPIRES_IN=24h

# Layer 1: Microservice Federation (MSF) Ports
PORT_MSF_AUTH=5000
PORT_MSF_EMPLOYEE=5001
PORT_MSF_ATTENDANCE=5002

# Layer 2: Microservice Master (MSM) Ports
PORT_MSM_USER=6001
PORT_MSM_EMPLOYEE=6002
PORT_MSM_ATTENDANCE=6003
PORT_MSM_ROLE=6004
PORT_MSM_JABATAN=6005
PORT_MSM_STATUS_WORK=6006
PORT_MSM_STATUS_EMPLOYEE=6007

# MSM Internal Service URLs
URL_MSM_USER=http://127.0.0.1:6001
URL_MSM_EMPLOYEE=http://127.0.0.1:6002
URL_MSM_ATTENDANCE=http://127.0.0.1:6003
URL_MSM_ROLE=http://127.0.0.1:6004
URL_MSM_JABATAN=http://127.0.0.1:6005
URL_MSM_STATUS_WORK=http://127.0.0.1:6006
URL_MSM_STATUS_EMPLOYEE=http://127.0.0.1:6007

# MSF Public URLs (Consumed by Frontend)
URL_MSF_AUTH=http://127.0.0.1:5000
URL_MSF_EMPLOYEE=http://127.0.0.1:5001
URL_MSF_ATTENDANCE=http://127.0.0.1:5002
